<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Numeros"/>
        <attribute name="authors" value="ANLATOFE"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-22 07:56:33 p.&#8239;m."/>
        <attribute name="created" value="QU5MQVRPRkU7QUlST0tBOzIwMjYtMDUtMjI7MDY6NTQ6MjIgcC7igK9tLjsxMDcwMg=="/>
        <attribute name="edited" value="QU5MQVRPRkU7QUlST0tBOzIwMjYtMDUtMjI7MDc6NTY6MzMgcC7igK9tLjsyOzEwODE2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, NumeroRandom, NumeroEscrito" type="Integer" array="False" size=""/>
            <declare name="Bandera" type="Boolean" array="False" size=""/>
            <assign variable="NumeroRandom" expression="Random(100)"/>
            <assign variable="Bandera" expression="true"/>
            <assign variable="i" expression="1"/>
            <while expression="Bandera = true">
                <output expression="&quot;Digite un n&#250;mero&quot;" newline="True"/>
                <input variable="NumeroEscrito"/>
                <if expression="NumeroEscrito = NumeroRandom">
                    <then>
                        <output expression="&quot;Has adivinado el n&#250;mero en &quot; &amp; i &amp; &quot; intentos.&quot;" newline="True"/>
                        <assign variable="Bandera" expression="false"/>
                    </then>
                    <else>
                        <if expression="NumeroEscrito &gt; NumeroRandom">
                            <then>
                                <output expression="&quot;El n&#250;mero es menor&quot;" newline="True"/>
                            </then>
                            <else>
                                <output expression="&quot;El n&#250;mero es mayor&quot;" newline="True"/>
                            </else>
                        </if>
                        <assign variable="i" expression="i + 1"/>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
